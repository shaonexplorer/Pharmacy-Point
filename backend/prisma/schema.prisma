generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Company {
  id          String    @id @default(cuid())
  name        String
  address     String?
  phone       String?
  email       String?   @unique
  website     String?
  licenseNo   String?   @unique
  established DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("companies")
}

model Product {
  id            String   @id @default(cuid())
  name          String
  description   String?
  sku           String   @unique
  price         Float
  quantity      Int      @default(0)
  lowStock      Int      @default(10)
  category      String?
  image         String?
  batchNo       String?
  brandName     String?
  genericName   String?
  expiryDate    DateTime?
  companyId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company      Company?  @relation(fields: [companyId], references: [id])
  orderItems   OrderItem[]

  @@map("products")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  dueAmount Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@map("customers")
}

model Order {
  id         String      @id @default(cuid())
  customerId String?
  status     OrderStatus @default(PENDING)
  total      Float
  items      OrderItem[]
  customer   Customer?   @relation(fields: [customerId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

enum Role {
  ADMIN
  PHARMACIST
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}